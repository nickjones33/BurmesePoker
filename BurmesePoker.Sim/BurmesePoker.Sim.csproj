<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BurmesePoker.Sim</RootNamespace>
    <AssemblyName>BurmesePoker.Sim</AssemblyName>

    <!-- The cover searches allocate hard (a meld index, a memo and a list per call), so a
         run is allocation-bound rather than compute-bound. Under the default workstation GC
         eight cores bought about 25% more throughput; the server GC gives each core its own
         heap and is worth several times that. A harness knob, not a domain change. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BurmesePoker.Domain\BurmesePoker.Domain.csproj" />
  </ItemGroup>

</Project>
