<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BurmesePoker.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Domain, and nothing else, ever. A view model that referenced a rendering technology
         would be a front end wearing a shared name (BUILD-PLAN §2, P13.1); LayeringTests
         asserts the absence rather than trusting it. -->
    <ProjectReference Include="..\BurmesePoker.Domain\BurmesePoker.Domain.csproj" />
  </ItemGroup>

</Project>
