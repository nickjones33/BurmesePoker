@*
    The question standing in front of you, as one action bar. The five IPlayerAgent asks, and
    no others: take, claim, permit, throw, declare.

    ⚠️ "Permit" is the odd one and it is odd by the rules (RULES.md §4.5): it arrives while it is
    somebody else's turn, so this bar can be standing in front of you when the spotlight is
    across the table. It is still your question and still your hand, which is why it is drawn
    here and not somewhere new.

    🔥 An action bar, not a paragraph (BUILD-PLAN P13.5). Board Game Arena's shape: at most four
    buttons, the main action first, the quieter one beside it, and the context on the same line
    rather than in a sentence above it. The rules citations that used to sit in the middle of
    the question are behind a "why?" — they answer a question nobody is asking twice, and the
    button has to be readable at a glance every single turn.

    ⚠️ This component holds no seat and no connection — it is given the prompt it draws and it
    hands an answer back. That is what keeps the seat's whole conversation with the table in one
    place (SeatBoard) rather than spread across the markup.

    Which card to throw is asked of the hand itself, because the cards are the controls.

    🔥 Each "why?" holds TWO kinds of sentence and they are gated differently (BUILD-PLAN P24.2).
    The first paragraph is the RULE, and it is ungated on purpose — a rule is not advice, which is
    the same distinction HandPanel.Words draws when it tells the ear about §5.1's ban outside the
    hints gate. The second is the COMPUTER'S REASONING about this very turn, and it is gated,
    because that is advice and the hints box is where a player says whether they want any.

    ⚠️ Both live inside the <details>, which is one of exactly two places MarkupStandardsTests
    lets prose onto the felt (§3.11 B9). A computed explanation is three sentences and the budget
    outside a disclosure is eighty characters.
*@

@using BurmesePoker.Domain.Money

@if (Asking is not { } asking)
{
    <p class="idle">
        <span class="glyph" aria-hidden="true">⋯</span>
        <span class="what" aria-hidden="true">Waiting</span>
        <span class="said">It is not your turn. Your hand is above.</span>
    </p>
}
else if (asking.Question == SeatQuestion.Take)
{
    <section class="bar" aria-labelledby="ask-heading">
        <h3 id="ask-heading">Take a card</h3>
        <div class="choices">
            @if (asking.AvailableDiscard is { } discard)
            {
                <button type="button" class="main" @ref="_first" @onclick="() => Answer(new SeatAnswer.Take(TurnAction.TakeDiscard))">
                    <span class="verb">Take</span>
                    <CardChip Card="discard" />
                </button>
                <button type="button" class="second" @onclick="() => Answer(new SeatAnswer.Take(TurnAction.DrawFromDeck))">
                    <span class="verb">Draw blind</span>
                    <span class="aside">@asking.DrawPileCount</span>
                </button>
            }
            else
            {
                <button type="button" class="main" @ref="_first" @onclick="() => Answer(new SeatAnswer.Take(TurnAction.DrawFromDeck))">
                    <span class="verb">Draw blind</span>
                    <span class="aside">@asking.DrawPileCount</span>
                </button>
            }
        </div>
        <details class="why">
            <summary>Why?</summary>
            <p>
                Taking the discard is not the same as being dealt it, so it would pay you nothing
                (RULES.md §4.4). A money card off the deck is yours and pays you at settlement
                whether you keep it or throw it away.
            </p>
            @if (Hints && asking.Rationale is { } why)
            {
                <p class="advice">@why.Sentence</p>
            }
        </details>
    </section>
}
else if (asking.Question == SeatQuestion.ClaimMoneyCard)
{
    <section class="bar" aria-labelledby="ask-heading">
        <h3 id="ask-heading">Claim off the table?</h3>
        <div class="choices">
            @if (asking.TurnedUpMoneyCards.Count > 0)
            {
                <button type="button" class="main" @ref="_first" @onclick="() => Answer(new SeatAnswer.Claim(true))">
                    <span class="verb">Claim</span>
                    <CardChip Card="asking.TurnedUpMoneyCards[^1]"
                              Token="@DisplayTokens.For(CardDisplayState.PaysOnce)"
                              TokenWords="a money card" />
                </button>
                <button type="button" class="second" @onclick="() => Answer(new SeatAnswer.Claim(false))">
                    <span class="verb">Leave it</span>
                </button>
            }
            else
            {
                <button type="button" class="main" @ref="_first" @onclick="() => Answer(new SeatAnswer.Claim(false))">
                    <span class="verb">Nothing to claim — go on</span>
                </button>
            }
        </div>
        <details class="why">
            <summary>Why?</summary>
            <p>
                Only the opening player may (RULES.md §4.5). It costs you your draw, and the
                table gives it rather than the deck — so you hold it, but it pays nobody.
            </p>
            @if (Hints && asking.Rationale is { } why)
            {
                <p class="advice">@why.Sentence</p>
            }
        </details>
    </section>
}
else if (asking.Question == SeatQuestion.ObjectToClaim)
{
    <section class="bar" aria-labelledby="ask-heading">
        <h3 id="ask-heading">May they take it?</h3>
        <p class="detail">
            @if (asking.PermissionAsked is { } permission)
            {
                @* ⚠️ Spoken, not hidden: the heading asks "May they take it?", and this line is
                   the only place "they" is resolved — a screen reader that never hears the
                   claimant's name is being asked to rule on somebody it cannot identify. *@
                <span class="verb">@Who(permission.Claimant) wants</span>
                <CardChip Card="permission.Card"
                          Token="@DisplayTokens.For(CardDisplayState.PaysOnce)"
                          TokenWords="a money card" />
            }
            <span class="said">
                They play after you, and you are holding that rank — which is the only reason you
                may say no.
            </span>
        </p>
        <div class="choices">
            <button type="button" class="main" @ref="_first" @onclick="() => Answer(new SeatAnswer.Objection(true))">
                <span class="verb">Refuse</span>
            </button>
            <button type="button" class="second" @onclick="() => Answer(new SeatAnswer.Objection(false))">
                <span class="verb">Allow it</span>
            </button>
        </div>
        <details class="why">
            <summary>Why?</summary>
            <p>
                Claiming needs the permission of the player who goes before the claimer, and only
                a holder may refuse (RULES.md §4.5). If they take it, you may not throw that rank
                to them for the rest of the round (RULES.md §5.1) — and refusing tells the table
                you are holding one.
            </p>
            @if (Hints && asking.Rationale is { } why)
            {
                <p class="advice">@why.Sentence</p>
            }
        </details>
    </section>
}
else if (asking.Question == SeatQuestion.Discard)
{
    <section class="bar throwing" aria-labelledby="ask-heading">
        <h3 id="ask-heading">Throw one away</h3>
        <p class="detail">
            @if (asking.Taken is { } taken)
            {
                <span class="verb" aria-hidden="true">You took</span>
                <CardChip Card="taken" Token="@Mark(asking, taken)" TokenWords="@Words(asking, taken)" />
            }
            <span class="said">Press a card in your hand above. Throwing it ends your turn.</span>
            <span class="hint" aria-hidden="true">↑ press a card</span>
        </p>
        <details class="why">
            <summary>Why?</summary>
            <p>
                Every turn is take one, throw one (RULES.md §5). The number on a card is what
                throwing it costs you — how many melded cards it gives up — and you may throw
                back the one you just took.
            </p>
            @if (Hints && asking.Rationale is { } why)
            {
                <p class="advice">@why.Sentence</p>
            }
        </details>
    </section>
}
else if (asking.Question == SeatQuestion.Declare)
{
    <section class="bar" aria-labelledby="ask-heading">
        <h3 id="ask-heading">All thirteen meld</h3>
        <ol class="laid">
            @foreach (var meld in asking.Hand.Melds)
            {
                <li @key="Key(meld)">
                    <span class="kind" aria-hidden="true">@meld.Label</span>
                    @foreach (var (slot, card) in meld.Slots)
                    {
                        <CardChip @key="card.Card.Id.Value"
                                  Card="card.Card"
                                  Token="@StandsFor(slot)"
                                  TokenWords="@StandsForWords(slot)" />
                    }
                </li>
            }
        </ol>
        <div class="choices">
            <button type="button" class="main" @ref="_first" @onclick="() => Answer(new SeatAnswer.Declaration(true))">
                <span class="verb">Declare and go out</span>
            </button>
            <button type="button" class="second" @onclick="() => Answer(new SeatAnswer.Declaration(false))">
                <span class="verb">Not yet</span>
            </button>
        </div>
        <details class="why">
            <summary>Why?</summary>
            <p>
                Nothing ends a round but a declaration (RULES.md §7.1): all thirteen laid down at
                once, in melds that share no card. The losers pay the winner the round stake — more
                of it if the thirteen hold no joker (§7.3) or the deal already won (§7.4), and all
                of it from one seat on somebody's third win in a row (§7.5) — and the money cards
                pay their owners whatever happens.
            </p>
            @if (Hints && asking.Rationale is { } why)
            {
                <p class="advice">@why.Sentence</p>
            }
        </details>
    </section>
}
else
{
    @*
        ⚠️ A question this markup does not know, drawn as nothing on purpose. Every known
        SeatQuestion is named above, so this arm is only ever a question added later — and the
        nearest-looking prompt would be worse than none: its answer would not fit what was asked
        (SeatAnswer.Fits), the refusal leaves the prompt standing, and the seat is softlocked
        until the patience runs out. An inert bar hands the turn to the stand-in honestly.
    *@
}

@code {
    private ElementReference _first;

    /// <summary>The question standing, or null when it is not your turn.</summary>
    [Parameter]
    public SeatPrompt? Asking { get; set; }

    /// <summary>
    /// Whether the computer is allowed to have an opinion — the hints box, handed down.
    /// </summary>
    /// <remarks>
    /// ⚠️ <b>It gates the computed paragraph and nothing else.</b> The rule text in every "why?"
    /// stays on with the hints off, because a rule is not advice (BUILD-PLAN P24.2). Unticking the
    /// box takes away the arrow and the reasoning and leaves the game explained.
    /// </remarks>
    [Parameter]
    public bool Hints { get; set; } = true;

    /// <summary>Called with the answer pressed. Refusing it is the seat's business, not this one's.</summary>
    [Parameter]
    public EventCallback<SeatAnswer> OnAnswer { get; set; }

    /// <summary>
    /// Focus the first control of the prompt, which is what §3.11 B7 asks for: focus moves when
    /// the turn does. Only one branch above is ever on screen, so only one of them captured it.
    /// </summary>
    /// <remarks>
    /// ⚠️ <b>Only the first control captures a reference.</b> Blazor invokes a <c>@@ref</c>
    /// capture when an element is <em>inserted</em>, not on every diff, so a second capture in
    /// the same branch would silently win (P13.4).
    /// </remarks>
    /// <remarks>
    /// <para>
    /// 🔥 <b>A focus call must never be able to take the circuit down, and this one could.</b>
    /// An <c>ElementReference</c> keeps its id after the element it named has been removed, so
    /// the emptiness check below only ever guarded the very first render. Everything after it
    /// raced: <c>OnAfterRenderAsync</c> decides to move focus because a question is standing,
    /// and between that decision and the interop call reaching the browser the question can be
    /// answered — the buttons become spans, the element goes, and the call lands on nothing.
    /// <b>Blazor turns an unhandled interop exception into a dead circuit</b>, and a dead
    /// circuit in this client is a page that looks completely correct and does nothing at all
    /// (P13.3's finding, in a new dress).
    /// </para>
    /// <para>
    /// ⚠️ <b>Found by playing 1,429 turns and reading the server log</b>, not by looking at the
    /// page: the browser showed a hand, a prompt and a spotlight, and every card refused every
    /// press in silence. A person who answers quickly hits exactly the same race.
    /// </para>
    /// <para>
    /// So focus is best-effort by construction. <b>Nothing to focus is not an error</b> — the
    /// turn has moved on, which is the only reason the control could have gone.
    /// </para>
    /// </remarks>
    public async ValueTask FocusAsync()
    {
        if (string.IsNullOrEmpty(_first.Id))
        {
            return;
        }

        try
        {
            await _first.FocusAsync();
        }
        catch (JSException)
        {
            // The control went away between the render that asked for this and the call
            // arriving. There is nothing to focus and nothing to do about it.
        }
        catch (JSDisconnectedException)
        {
            // The circuit is going away. Focus is the least of it.
        }
    }

    /// <summary>What the seats are called, so the claimer can be named rather than numbered.</summary>
    [Parameter]
    public IReadOnlyDictionary<PlayerId, string>? Names { get; set; }

    private Task Answer(SeatAnswer answer) => OnAnswer.InvokeAsync(answer);

    /// <summary>A seat's name, or its number when the table has not been told one.</summary>
    private string Who(PlayerId player) =>
        Names is not null && Names.TryGetValue(player, out var name) ? name : $"Seat {player.Value}";

    /// <summary>A stable key per meld: the cards it is made of, which no other meld holds (§3.1).</summary>
    private static string Key(MeldView meld) => string.Join('-', meld.Meld.CardIds.Select(id => id.Value));

    /// <summary>
    /// What a joker is standing in for, written after its face exactly as the console writes
    /// it — <c>🃏(4♦)</c>. <b>The interpretation is display only, never identity</b>
    /// (<c>MeldSlot</c>): it is the meld that decides what the joker is playing as here.
    /// </summary>
    private static string? StandsFor(MeldSlot slot) => slot.IsSubstitute
        ? $"({CardText.DisplayCode(slot.PlaysAs)}{CardText.DisplaySuit(slot.InSuit)})"
        : null;

    private static string? StandsForWords(MeldSlot slot) => slot.IsSubstitute
        ? $"standing in for the {CardWords.For(Card.Ranked(slot.Card.Id, slot.PlaysAs, slot.InSuit))}"
        : null;

    /// <summary>The money marker on the card you just took, if it is one (§3.11 A2).</summary>
    private static string? Mark(SeatPrompt asking, Card card) => asking.MoneyCards.Multiplier(card) switch
    {
        >= MoneyCardRegistry.Tripled => DisplayTokens.For(CardDisplayState.PaysTriple),
        1 => DisplayTokens.For(CardDisplayState.PaysOnce),
        _ => null
    };

    private static string? Words(SeatPrompt asking, Card card) => asking.MoneyCards.Multiplier(card) switch
    {
        >= MoneyCardRegistry.Tripled => "you took it, and it is a money card that pays three times",
        1 => "you took it, and it is a money card",
        _ => "you took it"
    };
}
